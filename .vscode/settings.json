{
  // .pio is in .gitignore, and VS Code search skips ignored files by default.
  // That hides every library header under .pio/libdeps from Ctrl+Shift+F.
  // Turn the ignore-file filter off, then exclude only the build artifacts.
  "search.useIgnoreFiles": false,
  "search.exclude": {
    "**/.pio/build": true,
    "**/.git": true
  },
  // Don't let the file watcher index .pio - it is large and churns on every build.
  "files.watcherExclude": {
    "**/.pio/**": true
  },

  // Keeps the enclosing class / #if branch pinned at the top while scrolling
  // the deeply nested library headers.
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 6
}
